{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfoliolive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio",
      "database_id": "0b831f57-5b88-4bfb-874a-ab65831f9e55"
    }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "none"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
